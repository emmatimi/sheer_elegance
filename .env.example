MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sheer_elegance
MYSQL_USER=sheer_elegance_admin
MYSQL_PASSWORD=root
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Or use Brevo instead:
# EMAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-xxxxx
MAIL_FROM="Oreoluwa Sheer Elegance <notifications@example.com>"
ADMIN_NOTIFY_EMAIL=admin@sheerelegance.com

SITE_URL=http://localhost:3000
# Optional: use this when email/receipt clients need a direct public logo URL.
# PUBLIC_LOGO_URL=https://your-domain.com/sheer-elegance-logo.png

# Image uploads for manual booking reference photos.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_UPLOAD_FOLDER=/sheer_elegance/booking-references

MONNIFY_ENV=sandbox
MONNIFY_API_KEY=MK_TEST_xxxxx
MONNIFY_SECRET_KEY=SK_TEST_xxxxx
MONNIFY_CONTRACT_CODE=0000000000
